# Copy to .env and fill in. Only JWT_SECRET is required to start.
JWT_SECRET=            # openssl rand -base64 48
ADMIN_PASSWORD=change-me-now
STRIPE_SECRET=         # sk_test_...
STRIPE_WEBHOOK_SECRET= # whsec_... (from `stripe listen`)
VITE_STRIPE_PK=        # pk_test_...
GOOGLE_CLIENT_ID=      # OAuth client (Web); also used by the frontend build
GOOGLE_MAPS_API_KEY=   # Distance Matrix API
PUBLIC_URL=http://localhost  # used in password-reset links
KAFKA_ENABLED=false       # true + `docker compose --profile kafka up` publishes ride events to Kafka
APP_PRODUCTION=false     # true: the API refuses to start with placeholder secrets
DISPATCH_RADIUS_KM=8     # drivers farther than this from the pickup are not offered the ride
REQUEST_EXPIRY_MINUTES=10  # unclaimed requests are cancelled after this long
CORS_ORIGIN=http://localhost
